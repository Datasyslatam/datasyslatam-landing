# Web3Forms access key for the contact form (https://web3forms.com).
# Local: copy this file to .env.local and fill in the value (never commit it).
# Railway: define it as a service variable; Vite inlines it at build time,
# so redeploy after changing it. Restrict the key to your domain in Web3Forms.
VITE_WEB3FORMS_ACCESS_KEY=

# Gemini key for the site assistant (/api/chat). Read only by the Node server
# (server/chat.mjs), never sent to the browser. Railway: service variable.
GEMINI_API_KEY=

# GitHub token (fine-grained, this repository only, Actions: read & write). The server uses it to start the
# Tuesday/Friday blog workflow when GitHub's cron skips it (server/blog-schedule.mjs). Railway: service variable.
BLOG_DISPATCH_TOKEN=
